# Supabase — Dashboard → Project Settings → Data API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Dashboard → Project Settings → API Keys → "Secret keys" tab.
# SECRET — bypasses Row Level Security. Never commit the real value and never
# expose it to the browser. This is NOT the publishable key.
# (Formerly the service_role key; SUPABASE_SERVICE_ROLE_KEY still works.)
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# Board passphrase. REQUIRED — the server refuses to start without it, so a
# deploy can't accidentally leave POST/DELETE open to the internet. Whoever
# pins entries types this into the board's unlock box.
#   BOARD_PASSWORD=$(openssl rand -base64 24)
BOARD_PASSWORD=change-me-to-something-long

# Passphrase for the no-contact streak counter only. Separate from
# BOARD_PASSWORD on purpose: pinning entries and resetting somebody else's
# streak are different privileges. OPTIONAL — falls back to the default in
# server/auth.js, which is public, so set this on any real deploy.
STREAK_PASSWORD=change-me-too

# Guards the visitor log at /api/admin/visits — the owner's credential, not
# something to share with people who pin entries. OPTIONAL, but there is no
# fallback: leave it unset and those routes return 503 and reveal nothing.
#   ADMIN_PASSWORD=$(openssl rand -base64 24)
ADMIN_PASSWORD=

# Set to "true" to require the passphrase for reading too (fully private board).
# Default: reads are public, writes need the passphrase.
REQUIRE_AUTH_FOR_READS=false

# Set when deploying behind a reverse proxy (Render, Fly, nginx…) so the
# failed-attempt throttle sees real client IPs instead of the proxy's.
# Number of proxy hops, or a subnet. Leave unset for direct/local runs.
# TRUST_PROXY=1

# Port the API listens on (optional, defaults to 3001).
PORT=3001
